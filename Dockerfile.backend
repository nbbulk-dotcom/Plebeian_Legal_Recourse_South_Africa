FROM python:3.12.10-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app/backend

RUN apt-get update && apt-get install -y build-essential gcc libpq-dev curl && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt

RUN pip install --upgrade pip==24.1.2 setuptools==68.0.0 wheel==0.41.2
RUN pip install --no-cache-dir -r requirements.txt

COPY backend /app/backend

ENV PORT=8000
EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--limit-concurrency", "200"]
